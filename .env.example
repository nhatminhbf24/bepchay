# Đặt mã 2410 trong trang cấu hình bí mật của hosting. Không commit tệp .env thật.
ACCESS_CODE=
SESSION_SECRET=replace-with-a-long-random-value
PORT=3000

# Chế độ MVP mặc định. Đổi thành firestore sau khi đã cấu hình tài khoản.
DATA_PROVIDER=local

